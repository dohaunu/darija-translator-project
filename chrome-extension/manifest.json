{
 "manifest_version": 3,
 "name": "Darija Translator Side Panel",
 "version": "1.0.0",
 "description": "Translate highlighted webpage text to Moroccan Darija.",
 "permissions": ["sidePanel", "contextMenus", "storage"],
 "host_permissions": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
 "background": {"service_worker": "background.js"},
 "side_panel": {"default_path": "panel.html"},
 "action": {"default_title": "Open Darija Translator"}
}
